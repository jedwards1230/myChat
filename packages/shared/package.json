{
	"name": "@mychat/shared",
	"version": "1.0.0",
	"main": "./src/index.ts",
	"react-native": "./src/index.ts",
	"files": [
		"build",
		"src"
	],
	"types": "./src/*.ts",
	"exports": {
		".": "./src/index.ts",
		"./*": "./src/*.ts",
		"./schemas": "./src/schemas/index.ts",
		"./schemas/models": "./src/schemas/models/index.ts"
	},
	"scripts": {
		"clean": "rm -rf .turbo",
		"dev": "tsc --watch",
		"format": "prettier --check . --ignore-path ../../.gitignore",
		"lint": "ESLINT_USE_FLAT_CONFIG=false eslint . -c eslint.config.cjs",
		"npm-check": "npm-check",
		"test": "jest",
		"tsc": "tsc"
	},
	"devDependencies": {
		"@mychat/eslint-config": "workspace:*",
		"@mychat/tsconfig": "workspace:*",
		"eslint": "^9.12.0",
		"npm-check": "^6.0.1",
		"prettier": "^3.3.3",
		"typescript": "beta"
	},
	"dependencies": {
		"zod": "^3.23.8"
	}
}
